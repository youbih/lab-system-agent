# Copy to .env and replace all placeholders. Never commit the real .env.
# Create this MySQL database before starting the backend.
# URL-encode special characters in the database username/password.
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/lab_system?charset=utf8mb4

# Generate a local key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_LOCAL_SECRET
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
